#!/usr/bin/env bash
# Desktop-installed Octop CLI. Prefers a CLI venv if present, else the
# desktop portable runtime under $OCTOP_HOME/portable.
set -euo pipefail

OCTOP_HOME="${OCTOP_HOME:-${HOME}/.octop}"
if [[ -x "${OCTOP_HOME}/venv/bin/octop" ]]; then
  exec "${OCTOP_HOME}/venv/bin/octop" "$@"
fi

ROOT="${OCTOP_HOME}/portable"
export OCTOP_HOME

PY=""
if [[ -x "${ROOT}/runtime/bin/python3" ]]; then
  PY="${ROOT}/runtime/bin/python3"
elif [[ -x "${ROOT}/runtime/bin/python" ]]; then
  PY="${ROOT}/runtime/bin/python"
elif [[ -f "${ROOT}/runtime/python.exe" ]]; then
  PY="${ROOT}/runtime/python.exe"
fi

if [[ -z "${PY}" || ! -f "${ROOT}/launch.py" ]]; then
  echo "Octop CLI: desktop runtime not found at ${ROOT}" >&2
  echo "Start the Octop desktop app once to unpack it, or reinstall." >&2
  exit 1
fi

export PYTHONNOUSERSITE=1
export OCTOP_GREEN_PACKAGES="${ROOT}/packages"
unset PYTHONPATH || true

exec "${PY}" "${ROOT}/launch.py" "$@"
